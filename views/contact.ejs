<section class="max-w-xl mx-auto py-12 text-white">
  <h1 class="text-4xl font-bold mb-8">Hinterlasse mir eine Nachricht</h1>

  <% if (typeof success !== 'undefined' && success) { %>
  <div class="mb-6 rounded bg-green-100 text-green-800 px-4 py-3">
    ✅ Nachricht wurde erfolgreich gesendet!
  </div>
  <% } %> <% if (typeof error !== 'undefined' && error) { %>
  <div class="mb-6 rounded bg-red-100 text-red-800 px-4 py-3">
    ❌ <%= error %>
  </div>
  <% } %>

  <form action="/contact" method="POST" class="space-y-6">
    <div>
      <label class="block text-lg mb-2">Name</label>
      <input
        type="text"
        name="name"
        required
        class="w-full p-3 rounded bg-white text-black border border-gray-300 focus:ring-2 focus:ring-blue-500"
      />
    </div>

    <div>
      <label class="block text-lg mb-2">Email</label>
      <input
        type="email"
        name="email"
        required
        class="w-full p-3 rounded bg-white text-black border border-gray-300 focus:ring-2 focus:ring-blue-500"
      />
    </div>

    <div>
      <label class="block text-lg mb-2">Nachricht</label>
      <textarea
        name="message"
        rows="6"
        required
        class="w-full p-3 rounded bg-white text-black border border-gray-300 focus:ring-2 focus:ring-blue-500"
      ></textarea>
    </div>

    <button
      class="bg-blue-600 text-white px-6 py-3 rounded hover:bg-blue-700 text-lg"
    >
      Nachricht senden
    </button>
  </form>
</section>
